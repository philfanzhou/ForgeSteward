{
  "schema": 1,
  "repository": "philfanzhou/ForgeSteward",
  "marketplace": "forge-steward",
  "description": "Supported ForgeSteward Agents, detection methods, and install/upgrade/uninstall commands. README and automatic installation share this file; tests/test_agent_catalog.py checks README consistency. For per-plugin Agents, apply always uses upgrade steps: with no installed plugins the uninstall step is empty. Install steps are only for the README first-install instructions.",
  "placeholders": {
    "version": "Unified version without v, for example 0.2.21. Read root VERSION in the repository or adjacent VERSION in the skill package.",
    "plugin": "Short plugin name, such as prepare-work. Use all plugins under plugins/ in the current version.",
    "source": "Separate source directory cloned at v{version}; README uses $HOME/code/ForgeSteward-v{version}. Installed skills do not depend on it after installation.",
    "zcode_cli": "Path to the bundled ZCode zcode.cjs CLI, found through detect_agent.paths and run with node."
  },
  "retired_plugins": ["find-work"],
  "step_fields": {
    "argv": "Argument array, expanded from placeholders and executed directly without a shell.",
    "per_plugin": "When true, run once for each plugin.",
    "only_installed": "When true, run only for installed ForgeSteward plugins, including retired_plugins; README lists all plugins.",
    "skip_if_exists": "Skip this step if the directory already exists.",
    "ok_exit_codes": "Exit codes treated as success; defaults to [0].",
    "only_if_marketplace": "When true, apply uses this Agent's detect_marketplace before any change and runs this step only if marketplace (forge-steward) is listed. If the list cannot be read, leave this Agent unchanged. README still lists the step."
  },
  "agents": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "verified": {"version": "2.1.269", "date": "2026-10-11", "platforms": ["darwin"]},
      "detect_agent": {
        "commands": ["claude"],
        "version_argv": ["claude", "--version"],
        "paths": {},
        "config_dirs": ["~/.claude"]
      },
      "detect_install": {
        "method": "list-command",
        "argv": ["claude", "plugin", "list", "--json"],
        "items": null,
        "id_field": "id",
        "id_suffix": "@forge-steward",
        "version_field": "version",
        "notes": "Output is an array of id, version, and scope entries; use only scope=user."
      },
      "detect_marketplace": {
        "argv": ["claude", "plugin", "marketplace", "list", "--json"],
        "items": null,
        "name_field": "name",
        "notes": "Output is an array with a name in each entry."
      },
      "install_mode": "per-plugin",
      "needs_local_source": false,
      "commands": {
        "install": [
          {"argv": ["claude", "plugin", "marketplace", "add", "philfanzhou/ForgeSteward@v{version}", "--scope", "user"], "per_plugin": false},
          {"argv": ["claude", "plugin", "install", "{plugin}@forge-steward", "--scope", "user"], "per_plugin": true}
        ],
        "upgrade": [
          {"argv": ["claude", "plugin", "uninstall", "{plugin}@forge-steward", "--scope", "user", "--keep-data"], "per_plugin": true, "only_installed": true},
          {"argv": ["claude", "plugin", "marketplace", "remove", "forge-steward", "--scope", "user"], "per_plugin": false, "only_if_marketplace": true},
          {"argv": ["claude", "plugin", "marketplace", "add", "philfanzhou/ForgeSteward@v{version}", "--scope", "user"], "per_plugin": false},
          {"argv": ["claude", "plugin", "install", "{plugin}@forge-steward", "--scope", "user"], "per_plugin": true}
        ],
        "uninstall": [
          {"argv": ["claude", "plugin", "uninstall", "{plugin}@forge-steward", "--scope", "user"], "per_plugin": true, "only_installed": true},
          {"argv": ["claude", "plugin", "marketplace", "remove", "forge-steward", "--scope", "user"], "per_plugin": false}
        ]
      }
    },
    {
      "id": "codex",
      "name": "Codex",
      "verified": {"version": "0.157.1", "date": "2026-10-13", "platforms": ["darwin"]},
      "detect_agent": {
        "commands": ["codex"],
        "version_argv": ["codex", "--version"],
        "paths": {},
        "config_dirs": ["~/.codex"]
      },
      "detect_install": {
        "method": "list-command",
        "argv": ["codex", "plugin", "list", "--marketplace", "forge-steward", "--json"],
        "items": "installed",
        "id_field": "pluginId",
        "id_suffix": "@forge-steward",
        "version_field": "version",
        "notes": "Restrict to the forge-steward marketplace to skip unrelated remote catalog fetches. Output is an object whose installed entries contain pluginId and version; scope defaults to user. Based on rust-v0.157.1 run_plugin_list and fetch_remote_marketplaces: https://github.com/openai/codex/blob/rust-v0.157.1/codex-rs/cli/src/plugin_cmd.rs . On failure, do not retry, fall back to an unfiltered query, or fill results from internal caches."
      },
      "detect_marketplace": {
        "argv": ["codex", "plugin", "marketplace", "list", "--json"],
        "items": "marketplaces",
        "name_field": "name",
        "notes": "Output is an object with a marketplaces array; each entry has a name."
      },
      "install_mode": "per-plugin",
      "needs_local_source": false,
      "commands": {
        "install": [
          {"argv": ["codex", "plugin", "marketplace", "add", "philfanzhou/ForgeSteward", "--ref", "v{version}"], "per_plugin": false},
          {"argv": ["codex", "plugin", "add", "{plugin}@forge-steward"], "per_plugin": true}
        ],
        "upgrade": [
          {"argv": ["codex", "plugin", "remove", "{plugin}@forge-steward"], "per_plugin": true, "only_installed": true},
          {"argv": ["codex", "plugin", "marketplace", "remove", "forge-steward"], "per_plugin": false, "only_if_marketplace": true},
          {"argv": ["codex", "plugin", "marketplace", "add", "philfanzhou/ForgeSteward", "--ref", "v{version}"], "per_plugin": false},
          {"argv": ["codex", "plugin", "add", "{plugin}@forge-steward"], "per_plugin": true}
        ],
        "uninstall": [
          {"argv": ["codex", "plugin", "remove", "{plugin}@forge-steward"], "per_plugin": true, "only_installed": true},
          {"argv": ["codex", "plugin", "marketplace", "remove", "forge-steward"], "per_plugin": false}
        ]
      }
    },
    {
      "id": "zcode",
      "name": "ZCode",
      "verified": {"version": "desktop 3.14.5, CLI 0.16.9", "date": "2026-10-11", "platforms": ["darwin"]},
      "detect_agent": {
        "commands": [],
        "requires_commands": ["node"],
        "paths": {
          "darwin": [
            "/Applications/ZCode.app/Contents/Resources/glm/zcode.cjs",
            "~/Applications/ZCode.app/Contents/Resources/glm/zcode.cjs"
          ]
        },
        "provides": "zcode_cli",
        "config_dirs": ["~/.zcode"],
        "notes": "Only macOS application paths were verified; on other platforms the user must supply the zcode.cjs path. Desktop and CLI share ~/.zcode/cli/plugins."
      },
      "detect_install": {
        "method": "list-command",
        "argv": ["node", "{zcode_cli}", "plugins", "list", "--json"],
        "items": null,
        "id_field": "id",
        "id_suffix": "@forge-steward",
        "version_field": "version",
        "notes": "Output is an array whose entries contain id, version, and enabled."
      },
      "detect_marketplace": {
        "argv": ["node", "{zcode_cli}", "plugins", "marketplace", "list", "--json"],
        "items": null,
        "name_field": "name",
        "notes": "Output is an array whose entries contain id and name, including official marketplaces."
      },
      "install_mode": "per-plugin",
      "needs_local_source": false,
      "commands": {
        "install": [
          {"argv": ["node", "{zcode_cli}", "plugins", "marketplace", "add", "philfanzhou/ForgeSteward@v{version}"], "per_plugin": false},
          {"argv": ["node", "{zcode_cli}", "plugins", "install", "{plugin}@forge-steward"], "per_plugin": true}
        ],
        "upgrade": [
          {"argv": ["node", "{zcode_cli}", "plugins", "uninstall", "{plugin}@forge-steward", "--force", "--keep-data"], "per_plugin": true, "only_installed": true},
          {"argv": ["node", "{zcode_cli}", "plugins", "marketplace", "remove", "forge-steward"], "per_plugin": false, "only_if_marketplace": true},
          {"argv": ["node", "{zcode_cli}", "plugins", "marketplace", "add", "philfanzhou/ForgeSteward@v{version}"], "per_plugin": false},
          {"argv": ["node", "{zcode_cli}", "plugins", "install", "{plugin}@forge-steward"], "per_plugin": true}
        ],
        "uninstall": [
          {"argv": ["node", "{zcode_cli}", "plugins", "uninstall", "{plugin}@forge-steward", "--force"], "per_plugin": true, "only_installed": true},
          {"argv": ["node", "{zcode_cli}", "plugins", "marketplace", "remove", "forge-steward"], "per_plugin": false}
        ]
      }
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "verified": {"version": "1.18.30", "date": "2026-09-30", "platforms": ["darwin", "linux"]},
      "detect_agent": {
        "commands": ["opencode"],
        "version_argv": ["opencode", "--version"],
        "paths": {},
        "config_dirs": ["~/.config/opencode"]
      },
      "detect_install": {
        "method": "receipt",
        "receipt": ".forge-steward-install.json",
        "pattern": "forge-steward-*",
        "version_field": "version",
        "user_roots": [
          {"env": "OPENCODE_CONFIG_DIR", "suffix": "skills"},
          {"env": "XDG_CONFIG_HOME", "suffix": "opencode/skills"},
          {"path": "~/.config/opencode/skills"}
        ],
        "project_root": ".opencode/skills",
        "notes": "user_roots uses the first set environment variable in order, or the final default path if none is set."
      },
      "install_mode": "all",
      "needs_local_source": true,
      "commands": {
        "install": [
          {"argv": ["git", "clone", "--branch", "v{version}", "--depth", "1", "https://github.com/philfanzhou/ForgeSteward.git", "{source}"], "per_plugin": false, "skip_if_exists": "{source}"},
          {"argv": ["python3", "{source}/scripts/opencode.py", "install", "--all", "--user"], "per_plugin": false}
        ],
        "upgrade": [
          {"argv": ["git", "clone", "--branch", "v{version}", "--depth", "1", "https://github.com/philfanzhou/ForgeSteward.git", "{source}"], "per_plugin": false, "skip_if_exists": "{source}"},
          {"argv": ["python3", "{source}/scripts/opencode.py", "uninstall", "--all", "--user"], "per_plugin": false, "ok_exit_codes": [0, 2]},
          {"argv": ["python3", "{source}/scripts/opencode.py", "install", "--all", "--user"], "per_plugin": false}
        ],
        "uninstall": [
          {"argv": ["git", "clone", "--branch", "v{version}", "--depth", "1", "https://github.com/philfanzhou/ForgeSteward.git", "{source}"], "per_plugin": false, "skip_if_exists": "{source}"},
          {"argv": ["python3", "{source}/scripts/opencode.py", "uninstall", "--all", "--user"], "per_plugin": false, "ok_exit_codes": [0, 2]}
        ]
      },
      "notes": "On Windows, use py -3 instead of python3. Uninstall exit code 2 means removal completed but same-name candidates remain in the target directory for manual inspection."
    },
    {
      "id": "deepseek-harness",
      "name": "DeepSeek Harness",
      "verified": {"version": "0.2.0-rc.2", "date": "2026-09-30", "platforms": ["darwin"]},
      "detect_agent": {
        "commands": [],
        "paths": {
          "darwin": [
            "/Applications/DeepSeek Harness.app",
            "~/Applications/DeepSeek Harness.app"
          ]
        },
        "config_dirs": ["~/.dsh"],
        "notes": "Only the macOS desktop app was verified; no CLI entrypoint has been verified."
      },
      "detect_install": {
        "method": "receipt",
        "receipt": ".forge-steward-install.json",
        "pattern": "forge-steward-*",
        "version_field": "version",
        "user_roots": [
          {"env": "DSH_HOME", "suffix": "skills"},
          {"path": "~/.dsh/skills"}
        ],
        "project_root": ".dsh/skills",
        "notes": "project_root is relative to the nearest Git root. If the Harness dshHome setting overrides the environment, set DSH_HOME to the same path."
      },
      "install_mode": "all",
      "needs_local_source": true,
      "commands": {
        "install": [
          {"argv": ["git", "clone", "--branch", "v{version}", "--depth", "1", "https://github.com/philfanzhou/ForgeSteward.git", "{source}"], "per_plugin": false, "skip_if_exists": "{source}"},
          {"argv": ["python3", "{source}/scripts/deepseek.py", "install", "--all", "--user"], "per_plugin": false}
        ],
        "upgrade": [
          {"argv": ["git", "clone", "--branch", "v{version}", "--depth", "1", "https://github.com/philfanzhou/ForgeSteward.git", "{source}"], "per_plugin": false, "skip_if_exists": "{source}"},
          {"argv": ["python3", "{source}/scripts/deepseek.py", "uninstall", "--all", "--user"], "per_plugin": false, "ok_exit_codes": [0, 2]},
          {"argv": ["python3", "{source}/scripts/deepseek.py", "install", "--all", "--user"], "per_plugin": false}
        ],
        "uninstall": [
          {"argv": ["git", "clone", "--branch", "v{version}", "--depth", "1", "https://github.com/philfanzhou/ForgeSteward.git", "{source}"], "per_plugin": false, "skip_if_exists": "{source}"},
          {"argv": ["python3", "{source}/scripts/deepseek.py", "uninstall", "--all", "--user"], "per_plugin": false, "ok_exit_codes": [0, 2]}
        ]
      },
      "notes": "On Windows, use py -3 instead of python3. Uninstall exit code 2 means removal completed but same-name candidates remain in the target directory for manual inspection."
    }
  ]
}
